{% macro target_to_entities(target, regex_filter = '') %}
{%- set ns = namespace(entities=[]) %}

{%- if target is mapping %}
    {%- set floor_ids = target.get('floor_id', []) %}

    {%- if floor_ids %}
        {%- set floor_ids = [ floor_ids ] if floor_ids is string else floor_ids %}
        {%- for floor_id in floor_ids %}
            {%- set ns.entities = ns.entities + [ floor_areas(floor_id) | map('area_entities') | sum(start=[]) ] %}
        {%- endfor %}
    {%- endif %}

    {%- for key in ['area_id', 'device_id', 'entity_id'] %}
        {%- set items = target.get(key, []) %}

        {%- if items %}
            {%- set items = [ items ] if items is string else items %}
            {%- set filter = key.split('_') | first %}
            {%- set items = items if filter == 'entity' else items | map(filter ~ '_entities') | sum(start=[]) %}
            {%- set ns.entities = ns.entities + [ items ] %}
        {%- endif %}

    {%- endfor %}
{%- endif %}

{%- set ns.entities = ns.entities | sum(start=[]) %}

{%- if regex_filter %}
    {%- set ns.entities = ns.entities | select('match', regex_filter) %}
{%- endif %}

{{ ns.entities | unique | list }}
{% endmacro %}


{% macro list_entities_from_floor(
    floor_id,
    domain_filter=None,
    regex_filter='',
    state_filter=None,
    ignore_label=None,
    exclude_domains=[]
) %}

{# Get all areas in the floor #}
{%- set area_ids = floor_areas(floor_id) -%}

{# Get all entities from those areas #}
{%- set entity_ids = area_ids | map('area_entities') | sum(start=[]) -%}

{# Filter by domain (fast) #}
{%- if domain_filter %}
    {%- set entity_ids = entity_ids
        | select('match', '^' ~ domain_filter ~ '\.')
        | list %}
{%- endif %}

{# Remove excluded domains #}
{%- if exclude_domains %}
    {%- for domain in exclude_domains %}
        {%- set entity_ids = entity_ids
            | reject('match', '^' ~ domain ~ '\.')
            | list %}
    {%- endfor %}
{%- endif %}

{# Regex filter (optional) #}
{%- if regex_filter %}
    {%- set entity_ids = entity_ids | select('match', regex_filter) | list %}
{%- endif %}

{# Ignore label entities #}
{%- if ignore_label %}
    {%- set ignored = label_entities(ignore_label) %}
    {%- set entity_ids = entity_ids | reject('in', ignored) | list %}
{%- endif %}

{# State filter (requires expand) #}
{%- if state_filter %}
     {%- set entity_ids = expand(entity_ids)
        | selectattr('state','equalto',state_filter)
        | map(attribute='entity_id')
        | list %}
{%- endif %}

{{ entity_ids | to_json }}

{% endmacro %}
